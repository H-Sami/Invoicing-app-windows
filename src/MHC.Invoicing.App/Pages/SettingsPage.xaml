<Page
    x:Class="MHC.Invoicing.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:MHC.Invoicing.App.Localization"
    Background="{ThemeResource MhcPageBrush}"
    Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="20" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
                <TextBlock localization:Localization.TextKey="SettingsTitle.Text" Style="{StaticResource MhcPageTitleStyle}" />
                <TextBlock localization:Localization.TextKey="SettingsSubtitle.Text" Style="{StaticResource MhcMutedTextStyle}" />
            </StackPanel>
            <Border Style="{StaticResource MhcCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock localization:Localization.TextKey="CompanySection.Text" Style="{StaticResource MhcSectionTitleStyle}" />
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock localization:Localization.TextKey="CompanyNameLabel.Text" />
                            <TextBox x:Name="CompanyNameArabic" localization:Localization.PlaceholderKey="CompanyName.PlaceholderText" localization:Localization.AutomationNameKey="CompanyName.AutomationProperties.Name" AutomationProperties.AutomationId="Settings.CompanyNameArabic" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock localization:Localization.TextKey="CompanyEnglishNameLabel.Text" />
                            <TextBox x:Name="CompanyNameEnglish" localization:Localization.PlaceholderKey="CompanyEnglishName.PlaceholderText" localization:Localization.AutomationNameKey="CompanyEnglishName.AutomationProperties.Name" AutomationProperties.AutomationId="Settings.CompanyNameEnglish" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="6">
                            <TextBlock localization:Localization.TextKey="VatNumberLabel.Text" />
                            <TextBox x:Name="CompanyVatNumber" localization:Localization.PlaceholderKey="VatNumber.PlaceholderText" localization:Localization.AutomationNameKey="VatNumber.AutomationProperties.Name" AutomationProperties.AutomationId="Settings.VatNumber" MaxLength="15" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                            <TextBlock localization:Localization.TextKey="CommercialRegistrationLabel.Text" />
                            <TextBox x:Name="CompanyCommercialRegistration" localization:Localization.PlaceholderKey="CommercialRegistration.PlaceholderText" localization:Localization.AutomationNameKey="CommercialRegistration.AutomationProperties.Name" AutomationProperties.AutomationId="Settings.CommercialRegistration" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="6">
                            <TextBlock localization:Localization.TextKey="BranchLabel.Text" />
                            <TextBox x:Name="CompanyBranch" localization:Localization.PlaceholderKey="Branch.PlaceholderText" localization:Localization.AutomationNameKey="Branch.AutomationProperties.Name" AutomationProperties.AutomationId="Settings.Branch" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                            <TextBlock localization:Localization.TextKey="OperatorLabel.Text" />
                            <TextBox x:Name="CompanyOperatorName" localization:Localization.PlaceholderKey="OperatorName.PlaceholderText" localization:Localization.AutomationNameKey="OperatorName.AutomationProperties.Name" AutomationProperties.AutomationId="Settings.OperatorName" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="6">
                            <TextBlock localization:Localization.TextKey="CompanyAddressLabel.Text" />
                            <TextBox x:Name="CompanyAddress" localization:Localization.PlaceholderKey="CompanyAddress.PlaceholderText" localization:Localization.AutomationNameKey="CompanyAddress.AutomationProperties.Name" AutomationProperties.AutomationId="Settings.Address" TextWrapping="Wrap" AcceptsReturn="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Spacing="6">
                            <TextBlock localization:Localization.TextKey="DefaultPaymentMethodLabel.Text" />
                            <ComboBox x:Name="DefaultPaymentMethodPicker" SelectedIndex="0" HorizontalAlignment="Stretch" localization:Localization.AutomationNameKey="DefaultPaymentMethodPicker.AutomationProperties.Name" AutomationProperties.AutomationId="Settings.DefaultPaymentMethod">
                                <ComboBoxItem localization:Localization.ContentKey="PaymentMethodCash.Content" />
                                <ComboBoxItem localization:Localization.ContentKey="PaymentMethodCard.Content" />
                                <ComboBoxItem localization:Localization.ContentKey="PaymentMethodBankTransfer.Content" />
                                <ComboBoxItem localization:Localization.ContentKey="PaymentMethodCredit.Content" />
                                <ComboBoxItem localization:Localization.ContentKey="PaymentMethodOther.Content" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="1" Spacing="6">
                            <TextBlock localization:Localization.TextKey="CompanyLogoLabel.Text" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button localization:Localization.ContentKey="ChooseLogoAction.Content" localization:Localization.AutomationNameKey="ChooseLogoAction.AutomationProperties.Name" AutomationProperties.AutomationId="Settings.ChooseLogo" Click="ChooseLogo_Click" Style="{StaticResource MhcSecondaryButtonStyle}" />
                                <Button localization:Localization.ContentKey="RemoveLogoAction.Content" localization:Localization.AutomationNameKey="RemoveLogoAction.AutomationProperties.Name" AutomationProperties.AutomationId="Settings.RemoveLogo" Click="RemoveLogo_Click" Style="{StaticResource MhcSecondaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="LogoStatus" localization:Localization.TextKey="CompanyLogoNone.Message" Style="{StaticResource MhcMutedTextStyle}" AutomationProperties.AutomationId="Settings.LogoStatus" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MhcCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock localization:Localization.TextKey="PreferencesSection.Text" Style="{StaticResource MhcSectionTitleStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock localization:Localization.TextKey="LanguageLabel.Text" />
                            <ComboBox x:Name="LanguagePicker" HorizontalAlignment="Stretch" SelectedIndex="0" localization:Localization.AutomationNameKey="LanguagePicker.AutomationProperties.Name" AutomationProperties.AutomationId="Settings.Language">
                                <ComboBoxItem localization:Localization.ContentKey="LanguageArabic.Content" />
                                <ComboBoxItem localization:Localization.ContentKey="LanguageEnglish.Content" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock localization:Localization.TextKey="ThemeLabel.Text" />
                            <ComboBox x:Name="ThemePicker" HorizontalAlignment="Stretch" SelectedIndex="0" localization:Localization.AutomationNameKey="ThemePicker.AutomationProperties.Name" AutomationProperties.AutomationId="Settings.Theme">
                                <ComboBoxItem localization:Localization.ContentKey="ThemeSystem.Content" />
                                <ComboBoxItem localization:Localization.ContentKey="ThemeLight.Content" />
                                <ComboBoxItem localization:Localization.ContentKey="ThemeDark.Content" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Button localization:Localization.ContentKey="SaveSettingsAction.Content" localization:Localization.AutomationNameKey="SaveSettingsAction.AutomationProperties.Name" AutomationProperties.AutomationId="Settings.Save" Click="SavePreferences_Click" HorizontalAlignment="Left" Style="{StaticResource MhcPrimaryButtonStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MhcCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock localization:Localization.TextKey="BackupSection.Text" Style="{StaticResource MhcSectionTitleStyle}" />
                    <TextBlock localization:Localization.TextKey="BackupHint.Text" Style="{StaticResource MhcMutedTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CreateBackupButton" localization:Localization.ContentKey="CreateBackupAction.Content" Click="CreateBackup_Click" localization:Localization.AutomationNameKey="CreateBackupAction.AutomationProperties.Name" AutomationProperties.AutomationId="Settings.CreateBackup" Style="{StaticResource MhcSecondaryButtonStyle}" />
                        <Button x:Name="RestoreBackupButton" localization:Localization.ContentKey="RestoreBackupAction.Content" Click="RestoreBackup_Click" localization:Localization.AutomationNameKey="RestoreBackupAction.AutomationProperties.Name" AutomationProperties.AutomationId="Settings.RestoreBackup" Style="{StaticResource MhcSecondaryButtonStyle}" />
                        <ProgressRing x:Name="MaintenanceProgress" Width="24" Height="24" IsActive="False" Visibility="Collapsed" localization:Localization.AutomationNameKey="MaintenanceProgress.AutomationProperties.Name" AutomationProperties.AutomationId="Settings.MaintenanceProgress" />
                    </StackPanel>
                    <TextBlock
                        x:Name="MaintenanceStatus"
                        Style="{StaticResource MhcMutedTextStyle}"
                        TextWrapping="Wrap"
                        AutomationProperties.AutomationId="Settings.MaintenanceStatus"
                        AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
