<Page
    x:Class="MHC.Invoicing.App.Pages.InvoicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:MHC.Invoicing.App.Localization"
    Background="{ThemeResource MhcPageBrush}"
    Loaded="Page_Loaded">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock localization:Localization.TextKey="InvoicesTitle.Text" Style="{StaticResource MhcPageTitleStyle}" />
            <TextBlock localization:Localization.TextKey="InvoicesSubtitle.Text" Style="{StaticResource MhcMutedTextStyle}" />
        </StackPanel>

        <AutoSuggestBox
            x:Name="InvoiceSearch"
            Grid.Row="1"
            MinHeight="44"
            QueryIcon="Find"
            localization:Localization.PlaceholderKey="InvoiceSearch.PlaceholderText"
            localization:Localization.AutomationNameKey="InvoiceSearch.AutomationProperties.Name"
            AutomationProperties.AutomationId="Invoices.Search"
            QuerySubmitted="InvoiceSearch_QuerySubmitted" />

        <Border Grid.Row="2" Style="{StaticResource MhcCardStyle}">
            <Grid>
                <TextBlock
                    x:Name="EmptyState"
                    localization:Localization.TextKey="EmptyInvoices.Text"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource MhcMutedTextStyle}" />
                <ListView
                    x:Name="InvoiceList"
                    SelectionMode="Single"
                    SelectionChanged="InvoiceList_SelectionChanged"
                    ContainerContentChanging="InvoiceList_ContainerContentChanging"
                    localization:Localization.AutomationNameKey="InvoiceList.AutomationProperties.Name"
                    AutomationProperties.AutomationId="Invoices.Results">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding PublicNumber}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DocumentTypeText}" Style="{StaticResource MhcMutedTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding CustomerName}" />
                                    <TextBlock Text="{Binding Id}" Style="{StaticResource MhcMutedTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding BusinessDateText}" />
                                <TextBlock Grid.Column="3" Text="{Binding GrandTotalText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button x:Name="PreviewButton" localization:Localization.ContentKey="InvoicePreviewAction.Content" Click="Preview_Click" IsEnabled="False" localization:Localization.AutomationNameKey="InvoicePreviewAction.AutomationProperties.Name" AutomationProperties.AutomationId="Invoices.Preview" Style="{StaticResource MhcSecondaryButtonStyle}" />
            <Button x:Name="PrintButton" localization:Localization.ContentKey="InvoicePrintAction.Content" Click="Print_Click" IsEnabled="False" localization:Localization.AutomationNameKey="InvoicePrintAction.AutomationProperties.Name" AutomationProperties.AutomationId="Invoices.Print" Style="{StaticResource MhcSecondaryButtonStyle}" />
            <Button x:Name="ExportButton" localization:Localization.ContentKey="InvoiceExportAction.Content" Click="Export_Click" IsEnabled="False" localization:Localization.AutomationNameKey="InvoiceExportAction.AutomationProperties.Name" AutomationProperties.AutomationId="Invoices.Export" Style="{StaticResource MhcSecondaryButtonStyle}" />
            <Button x:Name="DuplicateButton" localization:Localization.ContentKey="InvoiceDuplicateAction.Content" Click="Duplicate_Click" IsEnabled="False" localization:Localization.AutomationNameKey="InvoiceDuplicateAction.AutomationProperties.Name" AutomationProperties.AutomationId="Invoices.Duplicate" Style="{StaticResource MhcSecondaryButtonStyle}" />
            <Button x:Name="CreditNoteButton" localization:Localization.ContentKey="InvoiceCreditNoteAction.Content" Click="CreditNote_Click" IsEnabled="False" localization:Localization.AutomationNameKey="InvoiceCreditNoteAction.AutomationProperties.Name" AutomationProperties.AutomationId="Invoices.CreditNote" Style="{StaticResource MhcSecondaryButtonStyle}" />
            <Button x:Name="VoidButton" localization:Localization.ContentKey="InvoiceVoidAction.Content" Click="Void_Click" IsEnabled="False" localization:Localization.AutomationNameKey="InvoiceVoidAction.AutomationProperties.Name" AutomationProperties.AutomationId="Invoices.Void" Style="{StaticResource MhcSecondaryButtonStyle}" />
        </StackPanel>

        <TextBlock
            x:Name="OperationStatus"
            Grid.Row="4"
            Style="{StaticResource MhcMutedTextStyle}"
            TextWrapping="Wrap"
            AutomationProperties.AutomationId="Invoices.Status"
            AutomationProperties.LiveSetting="Assertive" />
    </Grid>
</Page>
