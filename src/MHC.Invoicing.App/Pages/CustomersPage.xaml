<Page
    x:Class="MHC.Invoicing.App.Pages.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:MHC.Invoicing.App.Localization"
    Background="{ThemeResource MhcPageBrush}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock localization:Localization.TextKey="CustomersTitle.Text" Style="{StaticResource MhcPageTitleStyle}" />
                <TextBlock localization:Localization.TextKey="CustomersSubtitle.Text" Style="{StaticResource MhcMutedTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="AddButton" Grid.Column="1" localization:Localization.ContentKey="AddCustomerAction.Content"
                    Click="Add_Click" Style="{StaticResource MhcPrimaryButtonStyle}" AutomationProperties.AutomationId="Customers.Add" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" localization:Localization.PlaceholderKey="DirectorySearch.PlaceholderText"
                            MinHeight="44" QueryIcon="Find" TextChanged="Search_TextChanged"
                            AutomationProperties.AutomationId="Customers.Search" />
            <ToggleSwitch x:Name="ArchivedToggle" Grid.Column="1" VerticalAlignment="Center"
                          Toggled="Archived_Toggled" AutomationProperties.AutomationId="Customers.IncludeArchived" />
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" IsClosable="True"
                 AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="Customers.Status" />

        <Grid Grid.Row="3">
            <ProgressRing x:Name="BusyIndicator" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border x:Name="EmptyPanel" Style="{StaticResource MhcCardStyle}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE77B;" FontSize="32" Foreground="{ThemeResource MhcMutedBrush}" />
                    <TextBlock localization:Localization.TextKey="EmptyCustomers.Text" HorizontalAlignment="Center" Style="{StaticResource MhcMutedTextStyle}" />
                </StackPanel>
            </Border>
            <ListView x:Name="CustomersList" SelectionMode="None" IsItemClickEnabled="False" ContainerContentChanging="CustomersList_ContainerContentChanging"
                      AutomationProperties.AutomationId="Customers.Results">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MhcCardStyle}" Margin="0,0,0,10">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding NameArabic}" Style="{StaticResource MhcSectionTitleStyle}" />
                                    <TextBlock Text="{Binding SecondaryLine}" Style="{StaticResource MhcMutedTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ContactLine}" Style="{StaticResource MhcMutedTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="{Binding EditLabel}" Tag="{Binding}" Click="Edit_Click" Visibility="{Binding ActiveVisibility}" AutomationProperties.Name="{Binding EditAutomationName}" />
                                    <Button Content="{Binding ArchiveLabel}" Tag="{Binding}" Click="Archive_Click" Visibility="{Binding ActiveVisibility}" AutomationProperties.Name="{Binding ArchiveAutomationName}" />
                                    <Button Content="{Binding RestoreLabel}" Tag="{Binding}" Click="Restore_Click" Visibility="{Binding ArchivedVisibility}" AutomationProperties.Name="{Binding RestoreAutomationName}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
