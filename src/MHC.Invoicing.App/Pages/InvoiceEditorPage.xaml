<Page
    x:Class="MHC.Invoicing.App.Pages.InvoiceEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:MHC.Invoicing.App.Localization"
    Background="{ThemeResource MhcPageBrush}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
  <ScrollViewer VerticalScrollBarVisibility="Auto" IsTabStop="False">
    <StackPanel Padding="32" Spacing="20" HorizontalAlignment="Stretch">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="EditorTitle" localization:Localization.TextKey="EditorTitle.Text" Style="{StaticResource MhcPageTitleStyle}"/>
          <TextBlock x:Name="EditorSubtitle" localization:Localization.TextKey="EditorSubtitle.Text" Style="{StaticResource MhcMutedTextStyle}"/>
        </StackPanel>
        <Border Grid.Column="1" Padding="12,6" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
          <TextBlock x:Name="DraftBadge" localization:Localization.TextKey="DraftBadge.Text" AutomationProperties.AutomationId="DraftBadge" AutomationProperties.LiveSetting="Polite"/>
        </Border>
      </Grid>

      <Border Style="{StaticResource MhcCardStyle}">
        <StackPanel Spacing="12">
          <TextBlock localization:Localization.TextKey="EditorCustomerDateSection.Text" Style="{StaticResource MhcSectionTitleStyle}"/>
          <AutoSuggestBox x:Name="CustomerSearch" MinHeight="44" localization:Localization.PlaceholderKey="EditorCustomerSearch.PlaceholderText"
                          TextChanged="CustomerSearch_TextChanged" SuggestionChosen="CustomerSearch_SuggestionChosen"
                          DisplayMemberPath="DisplayName" localization:Localization.AutomationNameKey="EditorCustomerSearch.AutomationProperties.Name" AutomationProperties.AutomationId="CustomerSearch"/>
          <TextBlock x:Name="SelectedCustomerText" localization:Localization.TextKey="CashCustomer.Text" AutomationProperties.AutomationId="SelectedCustomer"/>
          <Grid ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBox x:Name="CustomerNameArabic" AutomationProperties.AutomationId="CustomerSnapshot.NameArabic"/>
            <TextBox x:Name="CustomerNameEnglish" Grid.Column="1" AutomationProperties.AutomationId="CustomerSnapshot.NameEnglish"/>
            <TextBox x:Name="CustomerVatNumber" Grid.Row="1" MaxLength="15" AutomationProperties.AutomationId="CustomerSnapshot.Vat"/>
            <TextBox x:Name="CustomerCommercialRegistration" Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="CustomerSnapshot.CommercialRegistration"/>
            <TextBox x:Name="CustomerAddress" Grid.Row="2" Grid.ColumnSpan="2" AutomationProperties.AutomationId="CustomerSnapshot.Address"/>
          </Grid>
          <Button x:Name="SaveCustomerSnapshotButton" localization:Localization.ContentKey="SaveCustomerSnapshotAction.Content" localization:Localization.AutomationNameKey="SaveCustomerSnapshotAction.AutomationProperties.Name" AutomationProperties.AutomationId="CustomerSnapshot.Save" Click="SaveCustomerSnapshot_Click" HorizontalAlignment="Left" Style="{StaticResource MhcSecondaryButtonStyle}"/>
          <StackPanel Spacing="6">
            <TextBlock localization:Localization.TextKey="BusinessDateLabel.Text"/>
            <CalendarDatePicker x:Name="BusinessDatePicker" HorizontalAlignment="Stretch" CalendarIdentifier="GregorianCalendar" DateChanged="BusinessDatePicker_DateChanged"
                                localization:Localization.AutomationNameKey="BusinessDatePicker.AutomationProperties.Name" AutomationProperties.AutomationId="BusinessDate"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource MhcCardStyle}">
        <StackPanel Spacing="14">
          <TextBlock localization:Localization.TextKey="EditorLinesSection.Text" Style="{StaticResource MhcSectionTitleStyle}"/>
          <AutoSuggestBox x:Name="CatalogSearch" MinHeight="44" localization:Localization.PlaceholderKey="CatalogSearch.PlaceholderText"
                          TextChanged="CatalogSearch_TextChanged" SuggestionChosen="CatalogSearch_SuggestionChosen"
                          DisplayMemberPath="DisplayName" localization:Localization.AutomationNameKey="CatalogSearch.AutomationProperties.Name" AutomationProperties.AutomationId="CatalogSearch"/>
          <Button x:Name="AddOneOffLineButton" localization:Localization.ContentKey="AddOneOffLineAction.Content" localization:Localization.AutomationNameKey="AddOneOffLineAction.AutomationProperties.Name" AutomationProperties.AutomationId="InvoiceLines.AddOneOff" Click="AddOneOffLine_Click" HorizontalAlignment="Left" Style="{StaticResource MhcSecondaryButtonStyle}"/>
          <TextBlock x:Name="EmptyLinesText" localization:Localization.TextKey="EditorEmptyLines.Text" HorizontalAlignment="Center" Style="{StaticResource MhcMutedTextStyle}"/>
          <StackPanel x:Name="LinesPanel" Spacing="10" localization:Localization.AutomationNameKey="InvoiceLines.AutomationProperties.Name" AutomationProperties.AutomationId="InvoiceLines"/>
        </StackPanel>
      </Border>

      <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational"
               AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="AutosaveStatus"/>
      <InfoBar x:Name="ValidationBar" IsOpen="False" IsClosable="False" Severity="Error"
               AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="ValidationErrors"/>
      <InfoBar x:Name="ProfileNotReadyBar" IsOpen="False" IsClosable="False" Severity="Warning"
               AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ProfileNotReady">
        <InfoBar.ActionButton>
          <Button localization:Localization.ContentKey="OpenSettingsAction.Content" localization:Localization.AutomationNameKey="OpenSettingsAction.AutomationProperties.Name" AutomationProperties.AutomationId="ProfileNotReady.OpenSettings" Click="OpenSettings_Click" Style="{StaticResource MhcSecondaryButtonStyle}"/>
        </InfoBar.ActionButton>
      </InfoBar>

      <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Bottom" Spacing="8">
          <Button x:Name="PreviewButton" localization:Localization.ContentKey="EditorPreviewAction.Content" Click="PreviewButton_Click" IsEnabled="False" localization:Localization.AutomationNameKey="EditorPreviewAction.AutomationProperties.Name" AutomationProperties.AutomationId="PreviewInvoice"/>
          <Button x:Name="PrintButton" localization:Localization.ContentKey="EditorPrintAction.Content" Click="PrintButton_Click" IsEnabled="False" localization:Localization.AutomationNameKey="EditorPrintAction.AutomationProperties.Name" AutomationProperties.AutomationId="PrintInvoice"/>
          <Button x:Name="ExportButton" localization:Localization.ContentKey="EditorExportAction.Content" Click="ExportButton_Click" IsEnabled="False" localization:Localization.AutomationNameKey="EditorExportAction.AutomationProperties.Name" AutomationProperties.AutomationId="ExportInvoice"/>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource MhcCardStyle}">
          <StackPanel Spacing="12">
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock localization:Localization.TextKey="SubtotalLabel.Text"/><TextBlock x:Name="SubtotalText" Grid.Column="1"/></Grid>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock localization:Localization.TextKey="VatLabel.Text"/><TextBlock x:Name="VatText" Grid.Column="1"/></Grid>
            <Rectangle Height="1" Fill="{ThemeResource MhcCardBorderBrush}"/>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock localization:Localization.TextKey="GrandTotalLabel.Text" FontWeight="SemiBold"/><TextBlock x:Name="GrandTotalText" Grid.Column="1" FontSize="20" FontWeight="SemiBold"/></Grid>
            <Button x:Name="IssueButton" localization:Localization.ContentKey="EditorIssueAction.Content" HorizontalAlignment="Stretch" Style="{StaticResource MhcPrimaryButtonStyle}"
                    IsEnabled="False" Click="IssueButton_Click" localization:Localization.AutomationNameKey="EditorIssueAction.AutomationProperties.Name" AutomationProperties.AutomationId="IssueInvoice"/>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Page>
