<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="MhcFontFamily">Segoe UI Variable Text, Segoe UI, Segoe UI Arabic</FontFamily>
  <Style x:Key="MhcPageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MhcFontFamily}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="MhcSectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MhcFontFamily}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="MhcMutedTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MhcFontFamily}" />
    <Setter Property="Foreground" Value="{ThemeResource MhcMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</ResourceDictionary>
