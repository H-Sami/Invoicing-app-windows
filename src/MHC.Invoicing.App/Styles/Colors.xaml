<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="MhcPageBrush" Color="#F6F7F8" />
      <SolidColorBrush x:Key="MhcCardBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="MhcCardBorderBrush" Color="#18000000" />
      <SolidColorBrush x:Key="MhcMutedBrush" Color="#6B7280" />
      <SolidColorBrush x:Key="MhcAccentBrush" Color="#166A5B" />
      <SolidColorBrush x:Key="MhcAccentForegroundBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="MhcSuccessBrush" Color="#237A57" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="MhcPageBrush" Color="#101211" />
      <SolidColorBrush x:Key="MhcCardBrush" Color="#191C1B" />
      <SolidColorBrush x:Key="MhcCardBorderBrush" Color="#22FFFFFF" />
      <SolidColorBrush x:Key="MhcMutedBrush" Color="#A4ACA8" />
      <SolidColorBrush x:Key="MhcAccentBrush" Color="#58A998" />
      <SolidColorBrush x:Key="MhcAccentForegroundBrush" Color="#08110F" />
      <SolidColorBrush x:Key="MhcSuccessBrush" Color="#66C49C" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="MhcPageBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="MhcCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="MhcCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="MhcMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="MhcAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="MhcAccentForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="MhcSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
