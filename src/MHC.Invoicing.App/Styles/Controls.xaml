<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="MhcCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource MhcCardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource MhcCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style x:Key="MhcPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource MhcAccentBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource MhcAccentForegroundBrush}" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="18,8" />
  </Style>
  <Style x:Key="MhcSecondaryButtonStyle" TargetType="Button">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="18,8" />
  </Style>
</ResourceDictionary>
